# Ścieżka na hoście (Mac) — tu wrzucasz modele .safetensors (przetrwa rebuild kontenera)
# Może być względna (od katalogu nohooks) lub absolutna, np. /Users/bart/ai/comfyui-models
COMFYUI_MODELS_HOST_PATH=./comfyui-models

# Workflowy i ustawienia z UI ComfyUI (zapis Save w przeglądarce)
COMFYUI_USER_HOST_PATH=./comfyui/user

# --- ComfyUI: natywnie na Macu (zalecane, M3/MPS) vs Docker (wolne CPU) ---
# Backend w Dockerze łączy się z ComfyUI na hoście:
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_PORT=8188
# Tylko gdy używasz ComfyUI w Dockerze: COMFYUI_BASE_URL=http://comfyui:8188
#   + docker compose --profile docker-comfyui up -d comfyui

# Opcjonalnie — instalacja ComfyUI (domyślnie: ./.comfyui-native/ComfyUI)
# COMFYUI_NATIVE_HOME=/Users/bart/ComfyUI

# ComfyUI w Dockerze (Z-Image na CPU): w Docker Desktop → Memory ≥16 GB.
# Z-Image Turbo: przy Dockerze CPU ~576×576; natywnie MPS często 1024+.

# Opcjonalnie — token Hugging Face (modele z akceptacją licencji)
# HF_TOKEN=hf_...

# Parser stron produktowych (import itemu z linku sklepu)
# Docker: http://product-parser:8080  |  lokalnie z hosta: http://127.0.0.1:8191
PRODUCT_PARSER_URL=http://product-parser:8080

# Ranking zdjęć produktu (Ollama vision — opcjonalnie, fallback: heurystyki URL)
# Na Macu: ollama pull llava  (lepiej rozpoznaje modelkę vs packshot niż moondream)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=llava
PRODUCT_IMAGE_USE_OLLAMA=true
PRODUCT_IMAGE_MAX_CANDIDATES=16
PRODUCT_IMAGE_MAX_CATALOG=16

# Langfuse — logi / trace’y parsera i Ollama (osobny stack, profil docker compose)
# Uruchom: docker compose --profile langfuse up -d
# UI: http://localhost:3100  (login z LANGFUSE_INIT_* poniżej)
LANGFUSE_NEXTAUTH_URL=http://localhost:3100
LANGFUSE_INIT_ORG_NAME=Nohooks
LANGFUSE_INIT_PROJECT_NAME=Product Parser
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-nohooks-product-parser
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-nohooks-product-parser
LANGFUSE_INIT_USER_EMAIL=admin@nohooks.local
LANGFUSE_INIT_USER_PASSWORD=nohooks-admin
# Klucze wysyłane z product-parser (muszą zgadzać się z INIT powyżej)
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-nohooks-product-parser
LANGFUSE_SECRET_KEY=sk-lf-nohooks-product-parser
LANGFUSE_TRACING_ENABLED=true
# Backend + parser (trace item.import / item.create): LANGFUSE_HOST w Dockerze = http://langfuse-web:3000
# UI w przeglądarce:
LANGFUSE_UI_URL=http://localhost:3100
# Produkcja: openssl rand -hex 32  → LANGFUSE_ENCRYPTION_KEY
